# Copy to .env and adjust. .env is gitignored; never commit real secrets.
SPENDIT_ENV=dev
SPENDIT_DATABASE_URL=postgresql+asyncpg://spendit:spendit@localhost:5432/spendit
SPENDIT_REDIS_URL=redis://localhost:6379/0
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPENDIT_JWT_SECRET=change-me-in-your-own-env-file
